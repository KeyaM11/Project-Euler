def collatz_length(n):
    count = 1

    while n != 1:
        if n % 2 == 0:
            n = n // 2
        else:
            n = 3 * n + 1

        count += 1

    return count


longest = 0
answer = 0

for i in range(1, 1000000):
    length = collatz_length(i)

    if length > longest:
        longest = length
        answer = i

print(answer)
