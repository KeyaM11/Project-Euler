rows = 20
cols = 20

grid = [[0 for i in range(cols + 1)] for j in range(rows + 1)]

for i in range(rows + 1):
    grid[i][0] = 1

for j in range(cols + 1):
    grid[0][j] = 1

for i in range(1, rows + 1):
    for j in range(1, cols + 1):
        grid[i][j] = grid[i - 1][j] + grid[i][j - 1]

print(grid[20][20])
